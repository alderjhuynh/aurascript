# Aurascript rotating cube — ASCII 3D renderer
# Samples each cube face on a grid, rotates the samples (spin about Y
# plus a fixed camera tilt about X), projects with perspective, keeps
# the nearest sample per screen cell with a z-buffer, and shades each
# face with a brightness character from a simple headlight model.

# ---- screen / canvas ----
create a variable called width as an integer with a value of 78
create a variable called height as an integer with a value of 27
create a variable called canvasSize as an integer with a value of width
multiply the variable height by the variable canvasSize

create a variable called screen as an array of char with a size of canvasSize
create a variable called zbuf as an array of double with a size of canvasSize

# ---- small helper constants ----
create a variable called one as an integer with a value of 1
create a variable called twoD as a double with a value of 2.0

create a variable called halfW as a double with a value of width
divide the variable twoD by the variable halfW
create a variable called halfH as a double with a value of height
divide the variable twoD by the variable halfH

create a variable called piVar as a double with a value of pi
create a variable called twoPi as a double with a value of pi
multiply the variable twoD by the variable twoPi

create a variable called stepsCount as an integer with a value of 60
create a variable called stepsD as a double with a value of stepsCount
create a variable called ds as a double with a value of 2.0
divide the variable stepsD by the variable ds

create a variable called camDist as a double with a value of 5.0
create a variable called scaleK as a double with a value of 78.0

create a variable called tiltAngle as a double with a value of -0.55
create a variable called tiltCos as a double with a value of 0.0
create a variable called tiltSin as a double with a value of 0.0
assign the variable called tiltCos the value of call the function called cos with the value of tiltAngle
assign the variable called tiltSin the value of call the function called sin with the value of tiltAngle

create a variable called angle as a double with a value of 0.0
create a variable called cosA as a double with a value of 1.0
create a variable called sinA as a double with a value of 0.0
create a variable called spinStep as a double with a value of 0.06

# ---- per-sample / per-face scratch variables (reused every frame) ----
create a variable called u as a double with a value of 0.0
create a variable called v as a double with a value of 0.0
create a variable called uD as a double with a value of 0.0
create a variable called vD as a double with a value of 0.0
create a variable called i as an integer with a value of 0
create a variable called j as an integer with a value of 0
create a variable called lx as a double with a value of 0.0
create a variable called ly as a double with a value of 0.0
create a variable called lz as a double with a value of 0.0
create a variable called nxL as a double with a value of 0.0
create a variable called nyL as a double with a value of 0.0
create a variable called nzL as a double with a value of 0.0
create a variable called lum as a double with a value of 0.0
create a variable called ch as a char with a value of ' '
create a variable called k as an integer with a value of 0
create a variable called frame as an integer with a value of 0
create a variable called totalFrames as an integer with a value of 220

create a function called compute_lighting:
    create a variable called z1 as a double with a value of nzL
    multiply the variable cosA by the variable z1
    create a variable called t1 as a double with a value of nxL
    multiply the variable sinA by the variable t1
    subtract the variable t1 from the variable z1
    create a variable called y1 as a double with a value of nyL
    create a variable called rz as a double with a value of y1
    multiply the variable tiltSin by the variable rz
    create a variable called t2 as a double with a value of z1
    multiply the variable tiltCos by the variable t2
    add the variable t2 to the variable rz
    assign the variable called lum the value of 0.0
    subtract the variable rz from the variable lum
stop the function.

create a function called pick_char:
    when the variable lum is less than 0.15:
        assign the variable called ch the value of '.'
    otherwise:
        when the variable lum is less than 0.35:
            assign the variable called ch the value of ':'
        otherwise:
            when the variable lum is less than 0.55:
                assign the variable called ch the value of '-'
            otherwise:
                when the variable lum is less than 0.75:
                    assign the variable called ch the value of '='
                otherwise:
                    when the variable lum is less than 0.9:
                        assign the variable called ch the value of '#'
                    otherwise:
                        assign the variable called ch the value of '@'
                    stop when.
                stop when.
            stop when.
        stop when.
    stop when.
stop the function.

create a function called process_sample:
    create a variable called x1 as a double with a value of lx
    multiply the variable cosA by the variable x1
    create a variable called t1 as a double with a value of lz
    multiply the variable sinA by the variable t1
    add the variable t1 to the variable x1
    create a variable called z1 as a double with a value of lz
    multiply the variable cosA by the variable z1
    create a variable called t2 as a double with a value of lx
    multiply the variable sinA by the variable t2
    subtract the variable t2 from the variable z1
    create a variable called y1 as a double with a value of ly

    create a variable called rx as a double with a value of x1
    create a variable called ry as a double with a value of y1
    multiply the variable tiltCos by the variable ry
    create a variable called t3 as a double with a value of z1
    multiply the variable tiltSin by the variable t3
    subtract the variable t3 from the variable ry
    create a variable called rz as a double with a value of y1
    multiply the variable tiltSin by the variable rz
    create a variable called t4 as a double with a value of z1
    multiply the variable tiltCos by the variable t4
    add the variable t4 to the variable rz

    create a variable called denom as a double with a value of camDist
    add the variable rz to the variable denom
    create a variable called ooz as a double with a value of 1.0
    divide the variable denom by the variable ooz

    create a variable called sxd as a double with a value of rx
    multiply the variable scaleK by the variable sxd
    multiply the variable ooz by the variable sxd
    create a variable called sxF as a double with a value of halfW
    add the variable sxd to the variable sxF

    create a variable called syd as a double with a value of ry
    multiply the variable scaleK by the variable syd
    multiply the variable ooz by the variable syd
    create a variable called syF as a double with a value of halfH
    subtract the variable syd from the variable syF

    create a variable called sx as an integer with a value of sxF
    create a variable called sy as an integer with a value of syF

    when the variable sx is less than 0 return.
    when the variable sx is greater than or equal to width return.
    when the variable sy is less than 0 return.
    when the variable sy is greater than or equal to height return.

    create a variable called idx as an integer with a value of sy
    multiply the variable width by the variable idx
    add the variable sx to the variable idx

    when the variable ooz is greater than the variable zbuf at the index idx:
        assign the variable called zbuf at the index idx the value of ooz
        assign the variable called screen at the index idx the value of ch
    stop when.
stop the function.

# ---- main animation loop ----
write out the string "\e[2J"
repeat while the variable frame is less than totalFrames:
    write out the string "\e[H"

    assign the variable called k the value of 0
    repeat while the variable k is less than canvasSize:
        assign the variable called screen at the index k the value of ' '
        assign the variable called zbuf at the index k the value of 0.0
        add the variable one to the variable k
    stop repeating.

    assign the variable called cosA the value of call the function called cos with the value of angle
    assign the variable called sinA the value of call the function called sin with the value of angle

    # ---- FRONT face ----
    assign the variable called nxL the value of 0.0
    assign the variable called nyL the value of 0.0
    assign the variable called nzL the value of 1.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of u
                assign the variable called ly the value of v
                assign the variable called lz the value of 1.0
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- BACK face ----
    assign the variable called nxL the value of 0.0
    assign the variable called nyL the value of 0.0
    assign the variable called nzL the value of -1.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of u
                assign the variable called ly the value of v
                assign the variable called lz the value of -1.0
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- RIGHT face ----
    assign the variable called nxL the value of 1.0
    assign the variable called nyL the value of 0.0
    assign the variable called nzL the value of 0.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of 1.0
                assign the variable called ly the value of u
                assign the variable called lz the value of v
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- LEFT face ----
    assign the variable called nxL the value of -1.0
    assign the variable called nyL the value of 0.0
    assign the variable called nzL the value of 0.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of -1.0
                assign the variable called ly the value of u
                assign the variable called lz the value of v
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- TOP face ----
    assign the variable called nxL the value of 0.0
    assign the variable called nyL the value of 1.0
    assign the variable called nzL the value of 0.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of u
                assign the variable called ly the value of 1.0
                assign the variable called lz the value of v
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- BOTTOM face ----
    assign the variable called nxL the value of 0.0
    assign the variable called nyL the value of -1.0
    assign the variable called nzL the value of 0.0
    call the function called compute_lighting
    when the variable lum is greater than 0.0:
        call the function called pick_char
        assign the variable called i the value of 0
        repeat while the variable i is less than stepsCount:
            assign the variable called uD the value of i
            multiply the variable ds by the variable uD
            assign the variable called u the value of -1.0
            add the variable uD to the variable u
            assign the variable called j the value of 0
            repeat while the variable j is less than stepsCount:
                assign the variable called vD the value of j
                multiply the variable ds by the variable vD
                assign the variable called v the value of -1.0
                add the variable vD to the variable v
                assign the variable called lx the value of u
                assign the variable called ly the value of -1.0
                assign the variable called lz the value of v
                call the function called process_sample
                add the variable one to the variable j
            stop repeating.
            add the variable one to the variable i
        stop repeating.
    stop when.

    # ---- blit the frame: row indices are baked in at generation time ----
    write out the variable screen at the index 0 and the variable screen at the index 1 and the variable screen at the index 2 and the variable screen at the index 3 and the variable screen at the index 4 and the variable screen at the index 5 and the variable screen at the index 6 and the variable screen at the index 7 and the variable screen at the index 8 and the variable screen at the index 9 and the variable screen at the index 10 and the variable screen at the index 11 and the variable screen at the index 12 and the variable screen at the index 13 and the variable screen at the index 14 and the variable screen at the index 15 and the variable screen at the index 16 and the variable screen at the index 17 and the variable screen at the index 18 and the variable screen at the index 19 and the variable screen at the index 20 and the variable screen at the index 21 and the variable screen at the index 22 and the variable screen at the index 23 and the variable screen at the index 24 and the variable screen at the index 25 and the variable screen at the index 26 and the variable screen at the index 27 and the variable screen at the index 28 and the variable screen at the index 29 and the variable screen at the index 30 and the variable screen at the index 31 and the variable screen at the index 32 and the variable screen at the index 33 and the variable screen at the index 34 and the variable screen at the index 35 and the variable screen at the index 36 and the variable screen at the index 37 and the variable screen at the index 38 and the variable screen at the index 39 and the variable screen at the index 40 and the variable screen at the index 41 and the variable screen at the index 42 and the variable screen at the index 43 and the variable screen at the index 44 and the variable screen at the index 45 and the variable screen at the index 46 and the variable screen at the index 47 and the variable screen at the index 48 and the variable screen at the index 49 